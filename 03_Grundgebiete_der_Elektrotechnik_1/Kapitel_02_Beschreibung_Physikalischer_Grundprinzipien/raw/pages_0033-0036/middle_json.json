              "bbox": [
                0.029,
                0.663,
                0.442,
                0.703
              ],
              "content": [
                {
                  "type": "text",
                  "content": "■ Nicht mehrere Vorsätze gleichzeitig verwenden"
                }
              ]
            },
            {
              "type": "text",
              "index": 5,
              "bbox": [
                0.029,
                0.711,
                0.794,
                0.753
              ],
              "content": [
                {
                  "type": "text",
                  "content": "■ Vorsatz und Einheit bilden ein Symbol, Klammern sind nicht notwendig (z.B. EJ, km, hPa)"
                }
              ]
            },
            {
              "type": "text",
              "index": 6,
              "bbox": [
                0.029,
                0.761,
                0.418,
                0.798
              ],
              "content": [
                {
                  "type": "text",
                  "content": "■ Einheitenkurzzeichen erhalten keine Indizes"
                }
              ]
            },
            {
              "type": "text",
              "index": 7,
              "bbox": [
                0.029,
                0.81,
                0.891,
                0.852
              ],
              "content": [
                {
                  "type": "text",
                  "content": "■ Kombinationen von Kurzzeichen und ausgeschriebenen Vorsätzen und umgekehrt sind nicht zulässig"
                }
              ]
            },
            {
              "type": "text",
              "index": 8,
              "bbox": [
                0.029,
                0.86,
                0.573,
                0.9
              ],
              "content": [
                {
                  "type": "text",
                  "content": "Verwendung dimensionsloser Größen möglich, Beispiel Winkel"
                }
              ]
            }
          ],
          "sub_type": "text"
