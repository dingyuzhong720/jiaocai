    {
      "page_idx": 34,
      "blocks": [
        {
          "type": "paragraph_title",
          "index": 0,
          "bbox": [
            0.028,
            0.06,
            0.759,
            0.113
          ],
          "content": [
            {
              "type": "text",
              "content": "Beschreibung physikalischer Vorgänge – Zusammenfassung"
            }
          ],
          "level": 2
        },
        {
          "type": "list",
          "index": 1,
          "bbox": [
            0.025,
            0.139,
            0.959,
            0.86
          ],
          "content": [
            {
              "type": "text",
              "index": 2,
              "bbox": [
                0.028,
                0.142,
                0.755,
                0.189
              ],
              "content": [
                {
                  "type": "text",
                  "content": "■ Physikalische Vorgänge werden anhand physikalischer Größen beschrieben"
                }
              ]
            },
            {
              "type": "text",
              "index": 3,
              "bbox": [
                0.029,
                0.209,
                0.837,
                0.255
              ],
              "content": [
                {
                  "type": "text",
                  "content": "■ Physikalische Größen teilen sich auf in Basisgrößen und daraus abgeleiteten Größen"
                }
              ]
            },
            {
              "type": "text",
              "index": 4,
              "bbox": [
                0.029,
                0.276,
                0.795,
                0.323
              ],
              "content": [
                {
                  "type": "text",
                  "content": "■ Basisgrößen sind Meter, Sekunde, Kilogramm, Ampere, Kelvin, Candela und Mol"
                }
              ]
            },
            {
              "type": "text",
              "index": 5,
              "bbox": [
                0.029,
                0.344,
                0.955,
                0.39
              ],
              "content": [
                {
                  "type": "text",
                  "content": "■ Größen werden festgelegt durch einen Zahlenwert und die ihnen zugeordnete Einheit (z.B. t = 1 s)"
                }
              ]
            },
            {
              "type": "text",
              "index": 6,
              "bbox": [
                0.028,
                0.477,
                0.831,
                0.524
              ],
              "content": [
                {
                  "type": "text",
                  "content": "■ Atome bestehen aus einem Kern (Protonen, Neutronen) und einer Hülle (Elektronen)"
                }
              ]
            },
            {
              "type": "text",
              "index": 7,
              "bbox": [
                0.029,
                0.545,
                0.786,
                0.591
              ],
              "content": [
                {
                  "type": "text",
                  "content": "■ Verschiedene chemische Elemente unterscheiden sich in ihrer Kernladungszahl"
                }
              ]
            },
            {
              "type": "text",
              "index": 8,
              "bbox": [
                0.029,
                0.613,
                0.607,
                0.658
              ],
              "content": [
                {
                  "type": "text",
                  "content": "■ Es gibt verschiedene Formen der Bindung zwischen Atomen"
                }
              ]
            },
            {
              "type": "text",
              "index": 9,
              "bbox": [
                0.029,
                0.746,
                0.706,
                0.788
              ],
              "content": [
                {
                  "type": "text",
                  "content": "■ Wir unterscheiden in der Elektrotechnik Leiter, Halbleiter und Isolatoren"
                }
              ]
            },
            {
              "type": "text",
              "index": 10,
              "bbox": [
                0.029,
                0.814,
                0.727,
                0.855
              ],
              "content": [
                {
                  "type": "text",
                  "content": "■ Bei Leitern unterscheiden wir zwischen Elektronenleitern und Ionenleitern"
                }
              ]
            }
          ],
          "sub_type": "text"
        },
