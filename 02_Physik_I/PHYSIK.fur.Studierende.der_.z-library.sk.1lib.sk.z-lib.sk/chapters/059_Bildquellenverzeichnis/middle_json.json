              ],
              "content": [
                {
                  "type": "text",
                  "content": "Bild A.2 Korrelation zwischen 0,2- Dehngrenze x und Zugfestigkeit y für eine spezielle Stahlsorte (Einheit von x und "
                },
                {
                  "type": "equation_inline",
                  "content": "y : 1 0 ^ { 2 }   \\mathrm { M P a } )"
                },
                {
                  "type": "text",
                  "content": " . Die erste und zweite Regressionsgerade 1 und 2 schneiden sich im Punkt "
                },
                {
                  "type": "equation_inline",
                  "content": "( \\overline { { x } } , \\overline { { y } } ) \\equiv ( 8 { , } 6 7 ; 1 1 { , } 0 9 )"
                }
              ]
            }
