              ],
              "image_path": "raw/pages_0609-0640/images/page_632_chart_3.jpg",
              "content": "| x / 10^2 MPa | y / 10^2 MPa |\n| --- | --- |\n| ~7.8 | ~10.1 |\n| ~7.9 | ~10.5 |\n| ~8.0 | ~10.6 |\n| ~8.0 | ~10.9 |\n| ~8.2 | ~10.3 |\n| ~8.2 | ~10.4 |\n| ~8.2 | ~11.7 |\n| ~8.5 | ~11.4 |\n| ~8.6 | ~10.9 |\n| ~8.6 | ~11.2 |\n| ~8.9 | ~11.1 |\n| ~9.1 | ~10.5 |\n| ~9.2 | ~11.4 |\n| ~9.2 | ~11.6 |\n| ~9.7 | ~12.3 |\n| ~10.5 | ~12.3 |"
            },
