        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.091,
            0.793,
            0.334,
            0.812
          ],
          "level": 2,
          "content": "1.3 Die Physik heute"
        },
        {
          "type": "text",
          "bbox": [
            0.09,
            0.828,
            0.844,
            0.845
          ],
          "content": "Die Physik versucht, die Natur quantitativ auf allen Größenskalen zu beschreiben (Abb. 1.3)."
        },
        {
          "type": "text",
          "bbox": [
            0.091,
            0.846,
            0.296,
            0.865
          ],
          "content": "→ Film: Zehn hoch"
        },
        {
          "type": "text",
          "bbox": [
            0.09,
            0.887,
            0.794,
            0.903
          ],
          "content": "Hierbei findet die Physik Anwendungen z.B. in der Elektrotechnik, Chemie, Medizin,..."
        },
        {
