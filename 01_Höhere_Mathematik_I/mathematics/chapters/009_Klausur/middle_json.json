          ],
          "content": [
            {
              "type": "text",
              "content": "Beispielhafte Formelsammlung."
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.139,
            0.231,
            0.27,
            0.246
          ],
          "content": [
            {
              "type": "text",
              "content": "1. Identitäten:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 6,
          "bbox": [
            0.23,
            0.259,
            0.839,
            0.28
          ],
          "image_path": "raw/pages_0225-0240/images/page_229_equation_6.jpg",
          "content": "\\sin^ {2} (x) + \\cos^ {2} (x) = 1, \\quad \\tan^ {2} (x) + 1 = \\sec^ {2} (x), \\quad \\cot^ {2} (x) + 1 = \\csc^ {2} (x)"
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.138,
            0.298,
            0.337,
            0.313
          ],
          "content": [
            {
              "type": "text",
              "content": "2. Additionstheoreme:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 8,
          "bbox": [
            0.362,
            0.327,
            0.709,
            0.346
          ],
          "image_path": "raw/pages_0225-0240/images/page_229_equation_8.jpg",
          "content": "\\sin (a + b) = \\sin (a) \\cos (b) + \\cos (a) \\sin (b)"
        },
        {
          "type": "equation",
          "index": 9,
          "bbox": [
            0.362,
            0.349,
            0.709,
            0.367
          ],
          "image_path": "raw/pages_0225-0240/images/page_229_equation_9.jpg",
          "content": "\\cos (a + b) = \\cos (a) \\cos (b) - \\sin (a) \\sin (b)"
        },
        {
          "type": "equation",
          "index": 10,
          "bbox": [
            0.362,
            0.37,
            0.627,
            0.406
          ],
          "image_path": "raw/pages_0225-0240/images/page_229_equation_10.jpg",
          "content": "\\tan (a + b) = \\frac {\\tan (a) + \\tan (b)}{1 - \\tan (a) \\tan (b)}"
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.138,
            0.422,
            0.291,
            0.438
          ],
          "content": [
            {
              "type": "text",
              "content": "3. Doppelwinkel:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 12,
          "bbox": [
            0.21,
            0.45,
            0.857,
            0.486
          ],
          "image_path": "raw/pages_0225-0240/images/page_229_equation_12.jpg",
          "content": "\\sin (2 \\theta) = 2 \\sin (\\theta) \\cos (\\theta), \\quad \\cos (2 \\theta) = 1 - 2 \\sin^ {2} (\\theta), \\quad \\tan (2 \\theta) = \\frac {2 \\tan (\\theta)}{1 - \\tan^ {2} (\\theta)}"
        },
        {
          "type": "text",
          "index": 13,
          "bbox": [
            0.138,
            0.502,
            0.269,
            0.517
          ],
          "content": [
            {
              "type": "text",
              "content": "4. Halbwinkel:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 14,
          "bbox": [
            0.332,
            0.514,
            0.735,
            0.548
          ],
          "image_path": "raw/pages_0225-0240/images/page_229_equation_14.jpg",
          "content": "\\sin^ {2} (\\theta) = \\frac {1 - \\cos (2 \\theta)}{2}, \\quad \\cos^ {2} (\\theta) = \\frac {1 + \\cos (2 \\theta)}{2}"
        },
        {
          "type": "text",
          "index": 15,
          "bbox": [
            0.139,
            0.557,
            0.357,
            0.573
          ],
          "content": [
            {
              "type": "text",
              "content": "5. Sekans und Kosekans:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 16,
          "bbox": [
            0.38,
            0.581,
            0.688,
            0.618
          ],
          "image_path": "raw/pages_0225-0240/images/page_229_equation_16.jpg",
          "content": "\\sec (\\theta) := \\frac {1}{\\cos (\\theta)}, \\quad \\csc (\\theta) := \\frac {1}{\\sin (\\theta)}"
        },
        {
          "type": "text",
          "index": 17,
          "bbox": [
            0.137,
            0.634,
            0.573,
            0.652
          ],
          "content": [
            {
              "type": "text",
              "content": "6. Euklidische Norm: Für "
            },
            {
              "type": "equation_inline",
              "content": "\\underline{x} = (x_1, x_2, \\ldots, x_n)"
            },
            {
              "type": "text",
              "content": " ist"
            }
          ]
        },
        {
          "type": "equation",
          "index": 18,
          "bbox": [
            0.468,
            0.663,
            0.604,
            0.718
          ],
          "image_path": "raw/pages_0225-0240/images/page_229_equation_18.jpg",
          "content": "\\| \\underline {{x}} \\| = \\sqrt {\\sum_ {i = 1} ^ {n} x _ {i} ^ {2}}"
        },
        {
          "type": "text",
          "index": 19,
          "bbox": [
            0.138,
            0.733,
            0.468,
            0.751
          ],
          "content": [
            {
              "type": "text",
              "content": "7. Cauchy-Schwarz'sche Ungleichung:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 20,
          "bbox": [
            0.408,
            0.761,
            0.664,
            0.816
          ],
          "image_path": "raw/pages_0225-0240/images/page_229_equation_20.jpg",
          "content": "\\left| \\sum_ {i = 1} ^ {n} x _ {i} y _ {i} \\right| \\leq \\sqrt {\\sum_ {i = 1} ^ {n} x _ {i} ^ {2}} \\sqrt {\\sum_ {i = 1} ^ {n} y _ {i} ^ {2}}"
        },
        {
          "type": "text",
          "index": 21,
          "bbox": [
            0.138,
            0.832,
            0.35,
            0.847
          ],
          "content": [
            {
              "type": "text",
              "content": "8. Binomische Formeln:"
            }
          ]
        },
        {
          "type": "equation",
          "index": 22,
          "bbox": [
            0.258,
            0.857,
            0.813,
            0.901
          ],
          "image_path": "raw/pages_0225-0240/images/page_229_equation_22.jpg",
          "content": "(x + y) ^ {n} = \\sum_ {k = 0} ^ {n} \\binom {n} {k} x ^ {n - k} y ^ {k}, \\qquad (x - y) ^ {n + 1} = (x - y) \\sum_ {k = 0} ^ {n} a ^ {k} b ^ {n - k}"
        }
      ]
