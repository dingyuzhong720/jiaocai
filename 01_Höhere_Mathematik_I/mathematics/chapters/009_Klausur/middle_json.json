            0.457,
            0.093,
            0.564,
            0.108
          ],
          "content": [
            {
              "type": "text",
              "content": "WS 2021-22"
            }
          ]
        },
        {
          "type": "header",
          "index": 2,
          "bbox": [
            0.817,
            0.093,
            0.9,
            0.107
          ],
          "content": [
            {
              "type": "text",
              "content": "Seite 223"
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.138,
            0.135,
            0.784,
            0.153
          ],
          "content": [
            {
              "type": "text",
              "content": "2. Es sei die Funktion  "
            },
            {
              "type": "equation_inline",
              "content": "f: R \\to R"
            },
            {
              "type": "text",
              "content": "  gegeben durch  "
            },
            {
              "type": "equation_inline",
              "content": "f(x) := x^{3} - 4x^{2} + x + 6"
            },
            {
              "type": "text",
              "content": " ."
            }
          ]
        },
        {
          "type": "list",
          "index": 4,
          "bbox": [
            0.171,
            0.164,
            0.906,
            0.341
          ],
          "content": [
            {
              "type": "text",
              "index": 5,
              "bbox": [
                0.172,
                0.164,
                0.617,
                0.182
              ],
              "content": [
                {
                  "type": "text",
                  "content": "(a) Ist f gerade, ungerade oder keines von beiden?"
                }
              ]
            },
            {
              "type": "text",
              "index": 6,
              "bbox": [
                0.171,
                0.187,
                0.655,
                0.205
              ],
              "content": [
                {
                  "type": "text",
                  "content": "(b) Zeigen Sie, dass "
                },
                {
                  "type": "equation_inline",
                  "content": "f"
                },
                {
                  "type": "text",
                  "content": " in "
                },
                {
                  "type": "equation_inline",
                  "content": "x = -1"
                },
                {
                  "type": "text",
                  "content": " eine Nullstelle besitzt."
                }
              ]
            },
            {
              "type": "text",
              "index": 7,
              "bbox": [
                0.172,
                0.21,
                0.729,
                0.228
              ],
              "content": [
                {
                  "type": "text",
                  "content": "(c) Schreiben Sie "
                },
                {
                  "type": "equation_inline",
                  "content": "f"
                },
                {
                  "type": "text",
                  "content": " als Produkt von drei reellen Linearfaktoren."
                }
              ]
            },
            {
              "type": "text",
              "index": 8,
              "bbox": [
                0.171,
                0.233,
                0.907,
                0.286
              ],
              "content": [
                {
                  "type": "text",
                  "content": "(d) Kann jedes Polynom dritten Grades als Produkt von drei reellen Linearfaktoren geschrieben werden? Wenn ja, begründen Sie warum. Wenn nicht, dann geben Sie ein geeignetes Gegenbeispiel an."
                }
              ]
            },
            {
              "type": "text",
              "index": 9,
              "bbox": [
                0.172,
                0.291,
                0.907,
                0.341
              ],
              "content": [
                {
                  "type": "text",
                  "content": "(e) Finden Sie das größte Teilintervall von  "
                },
                {
                  "type": "equation_inline",
                  "content": "(-\\infty, 5)"
                },
                {
                  "type": "text",
                  "content": " , auf dem  "
                },
                {
                  "type": "equation_inline",
                  "content": "p(x) := x^{2} - x - 2"
                },
                {
                  "type": "text",
                  "content": "  invertierbar ist und geben Sie die Umkehrfunktion, ihren Definitionsbereich und ihren Wertebereich an."
                }
              ]
            }
          ],
          "sub_type": "text"
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.143,
            0.358,
            0.353,
            0.375
          ],
          "content": [
            {
              "type": "text",
              "content": "Ein paar Bemerkungen:"
            }
          ]
        },
        {
          "type": "list",
          "index": 11,
          "bbox": [
            0.139,
            0.386,
            0.906,
            0.468
          ],
          "content": [
            {
              "type": "text",
              "index": 12,
              "bbox": [
                0.139,
                0.386,
                0.906,
                0.422
              ],
              "content": [
                {
                  "type": "text",
                  "content": "1. Bemerken Sie, dass in 1(d) Punkte für die Begründung gegeben werden. Wenn Sie keine Begründung schreiben, bekommen Sie diese Punkte nicht."
                }
              ]
            },
            {
              "type": "text",
              "index": 13,
              "bbox": [
                0.138,
                0.433,
                0.906,
                0.468
              ],
              "content": [
                {
                  "type": "text",
                  "content": "2. Bemerken Sie, dass in 2(a), Sie die Definitionen von gerade und ungerade angeben müssen, um die Frage zu beantworten, obwohl nicht explizit danach gefragt wurde."
                }
              ]
            }
          ],
          "sub_type": "text"
        },
        {
          "type": "paragraph_title",
          "index": 14,
          "bbox": [
            0.113,
            0.493,
