        },
        {
          "type": "text",
          "bbox": [
            0.024,
            0.134,
            0.851,
            0.234
          ],
          "content": "Suchbaum für Monatsnamen, geordnet entsprechend der **lexikographischen** Reihenfolge:"
        },
        {
          "type": "image",
          "bbox": [
