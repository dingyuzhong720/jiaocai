        },
        {
          "type": "text",
          "bbox": [
            0.024,
            0.129,
            0.504,
            0.274
          ],
          "content": "HW = Physikalisch existierender, programmierbarer Rechner (Computer)"
        },
        {
          "type": "text",
          "bbox": [
            0.073,
            0.284,
            0.438,
            0.331
          ],
          "content": "→ Modifikation aufwendig"
        },
        {
          "type": "text",
          "bbox": [
            0.024,
            0.343,
            0.435,
            0.486
          ],
          "content": "SW = Auf HW ausführbares Programm (Textdatei) für gegebene Anwendung"
        },
        {
          "type": "text",
          "bbox": [
            0.073,
            0.498,
            0.395,
            0.541
          ],
          "content": "→ Modifikation einfach"
        },
        {
          "type": "list",
          "bbox": [
            0.024,
            0.556,
            0.527,
            0.805
          ],
          "sub_type": "text",
          "content": "In GGI1 wird die HW als **Black Box** betrachtet, die Programmcode ausführen kann\nInnerer HW-Aufbau: siehe Vorlesung **GGI2**"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.579,
            0.189,
            0.648,
            0.228
          ],
          "level": 2,
          "content": "User"
        },
        {
