            0.512,
            0.19
          ],
          "sub_type": "text",
          "content": "– 1. Versuch: siehe RWTHonline\n– 2. Versuch: siehe RWTHonline"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.163,
            0.197,
            0.491,
            0.215
          ],
          "level": 2,
          "content": "• Fragestunde GGI1 bei Fr. Eiden"
        },
