            ]
          }
        ]
      },
      {
        "type": "paragraph_title",
        "bbox": [
          0.129,
          0.286,
          0.327,
          0.306
        ],
        "content": [
          {
            "type": "text",
            "content": "B.9.9 宽字符支持"
          }
        ],
        "level": 2,
        "lines": [
          {
            "bbox": [
              0.131,
              0.286,
              0.325,
              0.304
            ]
          }
        ]
      },
      {
        "type": "text",
        "bbox": [
          0.078,
          0.332,
          0.911,
          0.438
        ],
        "content": [
          {
            "type": "text",
            "content": "在C++中，wchar_t是内置类型，而且wchar_t是关键字。在C99和C11中，wchar_t类型被定义在多个头文件中（stddef.h、stdlib.h、wchar.h、wctype.h）。与此类似，char16_t和char32_t都是C++11的关键字，但是在C11中它们都定义在uchar.h头文件中。"
          }
        ],
        "lines": [
          {
            "bbox": [
              0.135,
              0.333,
              0.872,
              0.351
            ]
          },
          {
            "bbox": [
              0.084,
              0.361,
              0.835,
              0.381
            ]
          },
          {
            "bbox": [
              0.082,
              0.391,
              0.908,
              0.409
            ]
          },
          {
            "bbox": [
              0.086,
              0.419,
              0.44,
              0.437
            ]
          }
        ]
      },
      {
        "type": "text",
        "bbox": [
          0.077,
          0.464,
          0.846,
          0.515
        ],
        "content": [
          {
            "type": "text",
            "content": "C++通过iostream头文件提供宽字符I/O支持（wchar_t、char16_t和char32_t），而 C99通过wchar.h头文件提供一种完全不同的I/O支持包。"
          }
        ],
        "lines": [
          {
            "bbox": [
              0.134,
              0.465,
              0.842,
              0.484
            ]
          },
          {
            "bbox": [
