                0.934
              ],
              "content": [
                {
                  "type": "text",
                  "content": "图 A.2 MemoryCell 类模板的实现"
                }
              ]
            }
          ],
          "sub_type": "code",
          "guess_lang": "cpp"
        }
      ]
