              "content": "<table><tr><td>标记</td><td>含义</td></tr><tr><td>bitand</td><td>&amp;</td></tr><tr><td>bitor</td><td>|</td></tr><tr><td>compl</td><td>~</td></tr><tr><td>not</td><td>!</td></tr><tr><td>not_eq</td><td>!=</td></tr><tr><td>or</td><td>||</td></tr><tr><td>or_eq</td><td>|=</td></tr><tr><td>xor</td><td>^</td></tr><tr><td>xor_eq</td><td>^=</td></tr></table>"
